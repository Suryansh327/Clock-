<!DOCTYPE html><html lang="en" style="--bg: #071018; --panel: #0d1b26; --panel2: #102431; --accent: #27d7ff; --accent2: #4775ff; --danger: #ff5573;"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-d300d507-a42e-413d-a2db-c71f2aecfb1c@mhtml.blink" />

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#071018">
<meta name="description" content="WaveStop — animated stopwatch and custom countdown timer.">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="manifest" href="https://suryansh327.github.io/WaveStop-App/manifest.json">
<link rel="icon" type="image/png" sizes="192x192" href="https://suryansh327.github.io/WaveStop-App/icons/icon-192.png">
<link rel="apple-touch-icon" href="https://suryansh327.github.io/WaveStop-App/icons/icon-192.png">
<title>WaveStop — Stopwatch &amp; Timer</title>

</head>
<body>
<div class="app">
<header>
  <div class="brand"><div class="logo"></div><div><h1>WaveStop</h1><div class="sub">Stopwatch • Countdown • Keyboard controlled</div></div></div>
  <div class="top-actions"><button id="settingsBtn" class="icon-btn" title="Settings">⚙</button></div>
</header>

<div class="main">
<section class="card stopwatch">
  <div class="mode-tabs">
    <button class="tab active" data-mode="stopwatch">Stopwatch</button>
    <button class="tab" data-mode="timer">Custom Timer</button>
  </div>

  <div id="timerInputs" style="display:none;margin-bottom:18px">
    <div class="grid3">
      <input id="hours" type="number" min="0" max="99" value="0" placeholder="Hours">
      <input id="minutes" type="number" min="0" max="59" value="1" placeholder="Minutes">
      <input id="seconds" type="number" min="0" max="59" value="0" placeholder="Seconds">
    </div>
    <button id="setTimer" style="width:100%;margin-top:8px">Set countdown</button>
  </div>

  <div id="displayWrap" class="display-wrap">
    <div class="wave"></div>
    <div id="display" class="display">00:00:00<small>.000</small></div>
  </div>
  <div id="status" class="status">Ready • Press Space to start</div>
  <div class="controls">
    <button id="startStop" class="primary">▶ Start</button>
    <button id="lapBtn">＋ Lap</button>
    <button id="resetBtn" class="danger">↻ Reset</button>
  </div>

  <div class="laps">
    <div class="laps-head"><span>Lap history</span><span id="lapCount">0 laps</span></div>
    <div id="lapList" class="lap-list"><div style="color:var(--muted);font-size:12px">No laps yet.</div></div>
  </div>
</section>

<aside class="card side">
  <div class="section">
    <h2>⌨ Keyboard controls</h2>
    <div class="help">
      <div><span>Start / Stop</span><kbd>Space</kbd></div>
      <div><span>Lap</span><kbd>L</kbd></div>
      <div><span>Reset</span><kbd>R</kbd></div>
      <div><span>Settings</span><kbd>S</kbd></div>
      <div><span>Switch mode</span><kbd>T</kbd></div>
      <div><span>Fullscreen</span><kbd>F</kbd></div>
    </div>
  </div>
  <div class="section">
    <h2>⚡ Quick timer</h2>
    <div class="field"><input id="quickMinutes" type="number" min="0" placeholder="Minutes"><button id="quickSet">Set</button></div>
    <div class="field"><input id="quickSeconds" type="number" min="0" placeholder="Seconds"><button id="quickSet30">+30s</button></div>
  </div>
  <div>
    <h2>ℹ Status</h2>
    <div style="font-size:12px;color:var(--muted);line-height:1.6">
      Millisecond precision is shown on screen. The timer uses the browser's high-resolution clock, so it remains accurate even if the tab is briefly busy.
    </div>
  </div>
</aside>
</div>
</div>

<div id="toast" class="toast"></div>

<div id="settings" class="settings">
  <div class="card settings-card">
    <button id="closeSettings" class="icon-btn close">✕</button>
    <h2 style="margin-top:0">Settings</h2>
    <div class="settings-row"><span>Theme</span><select id="theme"><option value="ocean">Ocean</option><option value="violet">Violet</option><option value="emerald">Emerald</option><option value="sunset">Sunset</option><option value="mono">Mono</option></select></div>
    <div class="settings-row"><span>Milliseconds</span><input id="showMs" type="checkbox" checked=""></div>
    <div class="settings-row"><span>Sound on timer finish</span><input id="sound" type="checkbox" checked=""></div>
    <div class="settings-row"><span>Keep screen awake</span><input id="wake" type="checkbox"></div>
    <button id="fullscreen" style="width:100%;margin-top:8px">⛶ Toggle fullscreen</button>
  </div>
</div>





</body></html>
