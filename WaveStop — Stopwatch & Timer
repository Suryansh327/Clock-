@charset "utf-8";

:root { --bg: #071018; --panel: #0d1b26; --panel2: #102431; --text: #eef8ff; --muted: #91a8b8; --accent: #27d7ff; --accent2: #4775ff; --danger: #ff5573; --border: rgba(255,255,255,.10); --shadow: 0 24px 70px rgba(0,0,0,.35); }

* { box-sizing: border-box; }

body { margin: 0px; min-height: 100vh; font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; color: var(--text); background: radial-gradient(circle at 20% 10%, color-mix(in srgb,var(--accent) 14%,transparent), transparent 35%),
  radial-gradient(circle at 85% 20%, color-mix(in srgb,var(--accent2) 14%,transparent), transparent 35%),
  var(--bg); }

.app { max-width: 1120px; margin: auto; padding: 28px 20px 40px; }

header { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; }

.brand { display: flex; align-items: center; gap: 12px; }

.logo { width: 44px; height: 44px; border: 2px solid var(--accent); border-radius: 14px; display: grid; place-items: center; box-shadow: 0 0 25px color-mix(in srgb,var(--accent) 25%,transparent); }

.logo::before { content: ""; width: 17px; height: 17px; border: 3px solid var(--accent); border-radius: 50%; }

h1 { font-size: 20px; margin: 0px; }

.sub { font-size: 12px; color: var(--muted); margin-top: 3px; }

.top-actions { display: flex; gap: 8px; }

button, select, input { font: inherit; color: var(--text); background: var(--panel2); border: 1px solid var(--border); border-radius: 12px; }

button { cursor: pointer; padding: 10px 14px; transition: transform 0.18s, background 0.18s, border 0.18s; }

button:hover { transform: translateY(-1px); border-color: color-mix(in srgb,var(--accent) 45%,var(--border)); }

button:active { transform: translateY(1px); }

.icon-btn { width: 44px; height: 44px; padding: 0px; }

.main { display: grid; grid-template-columns: 1.55fr 0.8fr; gap: 18px; }

.card { background: linear-gradient(145deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.02)); border: 1px solid var(--border); border-radius: 24px; box-shadow: var(--shadow); backdrop-filter: blur(14px); }

.stopwatch { padding: 28px; overflow: hidden; position: relative; }

.mode-tabs { display: flex; gap: 8px; margin-bottom: 22px; }

.tab { flex: 1 1 0%; }

.tab.active { background: var(--accent); color: rgb(0, 16, 24); border-color: transparent; font-weight: 800; }

.display-wrap { position: relative; min-height: 275px; display: grid; place-items: center; }

.wave { position: absolute; width: 260px; height: 260px; border-radius: 50%; border: 1px solid color-mix(in srgb,var(--accent) 30%,transparent); opacity: 0.25; }

.wave::before, .wave::after { content: ""; position: absolute; inset: 12%; border: 1px solid color-mix(in srgb,var(--accent) 35%,transparent); border-radius: 50%; }

.wave::after { inset: 24%; }

.running .wave { animation: 1.35s ease-out 0s infinite normal none running pulse; }

.running .wave::before { animation: 1.35s ease-out 0.22s infinite normal none running pulse; }

.running .wave::after { animation: 1.35s ease-out 0.44s infinite normal none running pulse; }

@keyframes pulse { 
  0% { transform: scale(0.72); opacity: 0.1; }
  45% { opacity: 0.75; }
  100% { transform: scale(1.5); opacity: 0; }
}

.display { font-variant-numeric: tabular-nums; letter-spacing: -2px; font-size: clamp(42px, 7vw, 76px); font-weight: 800; position: relative; text-shadow: 0 0 28px color-mix(in srgb,var(--accent) 22%,transparent); }

.display small { font-size: 0.38em; letter-spacing: 0px; color: var(--muted); font-weight: 600; }

.status { text-align: center; color: var(--muted); font-size: 13px; margin-top: -20px; margin-bottom: 22px; }

.controls { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }

.primary { background: var(--accent); color: rgb(0, 16, 24); border-color: transparent; font-weight: 800; min-width: 120px; }

.danger { color: rgb(255, 255, 255); background: color-mix(in srgb,var(--danger) 18%,var(--panel2)); border-color: color-mix(in srgb,var(--danger) 40%,var(--border)); }

.laps { margin-top: 24px; border-top: 1px solid var(--border); padding-top: 16px; }

.laps-head { display: flex; justify-content: space-between; color: var(--muted); font-size: 12px; margin-bottom: 8px; }

.lap-list { max-height: 180px; overflow: auto; }

.lap { display: flex; justify-content: space-between; padding: 9px 4px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); font-variant-numeric: tabular-nums; }

.side { padding: 22px; }

.side h2 { font-size: 15px; margin: 0px 0px 14px; }

.field { display: flex; gap: 8px; margin-bottom: 10px; }

.field > * { width: 100%; }

input { padding: 11px 12px; outline: none; }

input:focus, select:focus { border-color: var(--accent); }

.grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; }

.grid3 input { text-align: center; }

.section { padding-bottom: 18px; margin-bottom: 18px; border-bottom: 1px solid var(--border); }

kbd { background: rgb(6, 16, 24); border-top-color: ; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-left-color: ; border-left-style: ; border-left-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-bottom-width: 2px; border-radius: 6px; padding: 2px 7px; color: var(--accent); font-size: 11px; }

.help { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; font-size: 12px; color: var(--muted); }

.help div { display: flex; justify-content: space-between; gap: 6px; }

.toast { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%) translateY(20px); background: rgb(7, 16, 24); border: 1px solid var(--border); padding: 10px 15px; border-radius: 12px; opacity: 0; pointer-events: none; transition: 0.25s; z-index: 10; }

.toast.show { opacity: 1; transform: translateX(-50%); }

.settings { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.55); display: none; place-items: center; padding: 20px; z-index: 20; }

.settings.open { display: grid; }

.settings-card { width: min(480px, 100%); padding: 24px; }

.settings-row { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin: 14px 0px; }

.close { float: right; }

@media (max-width: 800px) {
  .main { grid-template-columns: 1fr; }
  .side { order: 2; }
  .display-wrap { min-height: 240px; }
}

@media (max-width: 520px) {
  .app { padding: 16px 12px 28px; }
  .stopwatch { padding: 20px; }
  .display { font-size: 39px; }
  .help { grid-template-columns: 1fr; }
  .top-actions button:not(.icon-btn) { display: none; }
}
